# WorkLens AI Environment Configuration

# Google Gemini API Key for AI Assistant & Tool Calling
GEMINI_API_KEY=your_gemini_key

# PostgreSQL Connection String (Optional: Defaults to SQLite worklens.db if unconfigured)
DATABASE_URL=your_postgresql_connection_string

# Frontend Public API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api
